# Database (Docker uses these defaults, local dev may differ)
DATABASE_URL=postgresql+asyncpg://warren:warren@db:5432/warren
POSTGRES_DB=warren
POSTGRES_USER=warren
POSTGRES_PASSWORD=warren

# Redis
REDIS_URL=redis://redis:6379/0

# API Keys — get your own at the URLs below
FRED_API_KEY=              # https://fred.stlouisfed.org/docs/api/api_key.html
ALPHA_VANTAGE_API_KEY=     # https://www.alphavantage.co/support/#api-key
FINNHUB_API_KEY=           # https://finnhub.io/register

# Internal API authentication — protects /api/* routes between services.
# Generate with: openssl rand -base64 32
# Leave empty to disable auth (not recommended).
API_KEY=

# ─── Notifications ───────────────────────────────────────────────────────────
# Bloomvalley supports two notification providers for both outbound alerts
# (PM briefs, insider signals, macro regime changes, weekly digest, pipeline
# failures) and inbound chat (you message the bot, it replies with the
# answer from the same LLM the web app uses).
#
# Set ONE provider. Default is signal.

NOTIFICATION_PROVIDER=signal   # signal | telegram | none

# --- Signal (default) ---
# Bridge installed via the signal-gateway docker stack:
#   https://github.com/freducom/signal-gateway
# Bring signal-gateway up first, link your account by QR, then copy the
# NOTIFY_TOKEN and ROUTER_TOKEN values from signal-gateway/.env here.
SIGNAL_NOTIFY_URL=http://signal-gateway-notify:8090/notify
SIGNAL_NOTIFY_TOKEN=
SIGNAL_ROUTER_URL=http://signal-gateway-router:8091
SIGNAL_ROUTER_TOKEN=
SIGNAL_PREFIX=bv

# --- Telegram (alternative) ---
# Only used when NOTIFICATION_PROVIDER=telegram.
# Setup: message @BotFather on Telegram, /newbot, copy token.
# Chat ID: message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Application
LOG_LEVEL=INFO
TZ=Europe/Helsinki

# Frontend URL — used for CORS. Change to your domain when behind a reverse proxy.
# Examples: http://localhost:3000, http://bloomvalley.example.com
FRONTEND_URL=http://localhost:3000

# Custom data storage (optional — defaults to ./data/postgres and ./data/redis)
# POSTGRES_DATA_DIR=/mnt/storage/bloomvalley/postgres
# REDIS_DATA_DIR=/mnt/storage/bloomvalley/redis
